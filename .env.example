# Copy this file to .env and fill in your own keys. .env is git-ignored; never commit it.
# Required: free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key
# Optional, only for the hosted provider shown commented out in config/models.yaml:
GROQ_API_KEY=

# Optional: override data file links if the defaults break.
# Zillow links: https://www.zillow.com/research/data/   Redfin: https://www.redfin.com/news/data-center/
# REDFIN_METRO_URL=
# REDFIN_CITY_URL=
# ZILLOW_ZHVI_CITY_URL=
# ZILLOW_ZORI_CITY_URL=
# ZILLOW_DTP_METRO_URL=   (days to pending; default is the mean, smoothed, metro file. Point it at a median file to use that)

# Optional: mortgage baseline rule, "13w" (default) or "affordability"
# RETREND_MORTGAGE_RULE=13w

# Optional: path to a district enrollment CSV for the schools worker
# SCHOOLS_FILE=C:\path\to\district_enrollment.csv

# Optional: path to a ZIP -> city CSV (columns zip, city, state). Default: run `retrend zip-fetch`.
# ZIP_FILE=C:\path\to\us_zip.csv

# Optional: how the building-permits signal is read: "context" (default, takes no side),
# "demand" (more permits = builders see demand = prices up) or "supply" (more permits = more supply = prices down)
# RETREND_PERMITS_RULE=context

# Optional: where the news signal comes from, "gnews" (default, Google News RSS) or "gdelt"
# RETREND_NEWS_SOURCE=gnews
